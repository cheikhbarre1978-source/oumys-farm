rules_version = '2';

service cloud.firestore {
  function isAdmin() {
    return request.auth != null
      && request.auth.token.email == 'cheikhbarre1978@gmail.com'
      && request.auth.token.firebase.sign_in_provider == 'password';
  }

  function validDeliveryZone(zone) {
    return zone is map
      && zone.keys().hasOnly(['id', 'name', 'areas', 'fee'])
      && zone.keys().hasAll(['id', 'name', 'areas', 'fee'])
      && zone.id is string
      && zone.id.size() > 0
      && zone.id.size() <= 40
      && zone.name is string
      && zone.name.size() > 0
      && zone.name.size() <= 60
      && zone.areas is string
      && zone.areas.size() <= 180
      && zone.fee is int
      && zone.fee >= 0
      && zone.fee <= 100000;
  }

  // Les règles n'ont pas de boucle : on vérifie les 12 premiers emplacements possibles.
  function validZoneAt(zones, index) {
    return zones.size() <= index || validDeliveryZone(zones[index]);
  }

  function validDeliverySettings() {
    let data = request.resource.data;
    return data.keys().hasOnly(['zones', 'updatedAt'])
      && data.keys().hasAll(['zones', 'updatedAt'])
      && data.updatedAt is timestamp
      && data.zones is list
      && data.zones.size() >= 1
      && data.zones.size() <= 12
      && validZoneAt(data.zones, 0)
      && validZoneAt(data.zones, 1)
      && validZoneAt(data.zones, 2)
      && validZoneAt(data.zones, 3)
      && validZoneAt(data.zones, 4)
      && validZoneAt(data.zones, 5)
      && validZoneAt(data.zones, 6)
      && validZoneAt(data.zones, 7)
      && validZoneAt(data.zones, 8)
      && validZoneAt(data.zones, 9)
      && validZoneAt(data.zones, 10)
      && validZoneAt(data.zones, 11);
  }

  function validAlbumPhoto(photoId) {
    let data = request.resource.data;
    return data.keys().hasOnly(['id', 'image', 'caption', 'createdAt'])
      && data.keys().hasAll(['id', 'image', 'caption', 'createdAt'])
      && data.id == photoId
      && data.image is string
      && data.image.size() <= 500000
      && data.image.matches('^data:image/jpeg;base64,.*')
      && data.caption is string
      && data.caption.size() <= 140
      && data.createdAt is timestamp;
  }

  function validDelivery(orderId) {
    let data = request.resource.data;
    return data.keys().hasOnly(['orderId', 'deliveredAt'])
      && data.keys().hasAll(['orderId', 'deliveredAt'])
      && data.orderId == orderId
      && data.deliveredAt is timestamp;
  }

  function validAnnouncement() {
    let data = request.resource.data;
    return data.keys().hasOnly(['title', 'text', 'active', 'tone', 'updatedAt'])
      && data.keys().hasAll(['title', 'text', 'active', 'tone', 'updatedAt'])
      && data.title is string
      && data.title.size() <= 60
      && data.text is string
      && data.text.size() <= 500
      && data.active is bool
      && (data.tone == 'info' || data.tone == 'important')
      && data.updatedAt is timestamp;
  }

  function validWhatsAppSettings() {
    let data = request.resource.data;
    return data.keys().hasOnly(['phone', 'updatedAt'])
      && data.keys().hasAll(['phone', 'updatedAt'])
      && data.phone is string
      && data.phone.matches('^[0-9]{8,15}$')
      && data.updatedAt is timestamp;
  }

  // Commande saisie par la ferme (téléphone, WhatsApp, sur place) : comme une commande du site,
  // avec l'origine en plus, une note facultative, et une adresse qui peut rester vide.
  function validAdminOrder(orderId) {
    let data = request.resource.data;
    let customer = data.customer;
    return data.keys().hasOnly(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total', 'source', 'note'])
      && data.keys().hasAll(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total', 'source'])
      && data.id == orderId
      && data.date is string
      && data.date.size() <= 40
      && data.createdAt is timestamp
      && data.source in ['telephone', 'whatsapp', 'place']
      && (!('note' in data) || (data.note is string && data.note.size() <= 300))
      && customer is map
      && customer.keys().hasOnly(['name', 'phone', 'address', 'zone'])
      && customer.keys().hasAll(['name', 'phone', 'address', 'zone'])
      && customer.name is string
      && customer.name.size() > 0
      && customer.name.size() <= 100
      && customer.phone is string
      && customer.phone.size() >= 8
      && customer.phone.size() <= 25
      && customer.address is string
      && customer.address.size() <= 300
      && customer.zone is string
      && customer.zone.size() <= 200
      && data.items is list
      && data.items.size() > 0
      && data.items.size() <= 50
      && data.subtotal is number
      && data.subtotal >= 0
      && data.fee is number
      && data.fee >= 0
      && data.total is number
      && data.total == data.subtotal + data.fee;
  }

  // --- Modification de sa commande par le client ---
  // Possible tant que la ferme n'a rien touché (pas de verrou, de facture, de modification ni d'annulation),
  // dans la limite de 7 jours. Une ligne existante ne change que par sa quantité ; une ligne ajoutée doit
  // porter le prix et le nom du catalogue ; adresse, frais et lignes d'origine restent ceux de la commande.
  function newLineOk(line) {
    return line is map
      && line.keys().hasOnly(['id', 'name', 'category', 'price', 'unit', 'qty'])
      && line.keys().hasAll(['id', 'name', 'category', 'price', 'unit', 'qty'])
      && line.id is string
      && line.name is string
      && line.qty is number
      && line.qty > 0
      && line.qty <= 100
      && get(/databases/(default)/documents/catalogProducts/$(line.id)).data.price == line.price
      && get(/databases/(default)/documents/catalogProducts/$(line.id)).data.name == line.name;
  }

  function clientLineOk(items, oldItems, i) {
    return items.size() <= i
      || (i < oldItems.size()
          ? (items[i].diff(oldItems[i]).affectedKeys().hasOnly(['qty'])
             && items[i].qty is number
             && items[i].qty >= 0
             && items[i].qty <= 100)
          : newLineOk(items[i]));
  }

  function lineAmount(items, i) {
    return items.size() > i ? math.round(items[i].price * items[i].qty) : 0;
  }

  function validClientEdit(orderId) {
    let data = request.resource.data;
    let old = resource.data;
    let items = data.items;
    let oldItems = old.items;
    return request.auth != null
      && data.keys().hasOnly(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total', 'clientEditedAt'])
      && data.keys().hasAll(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total', 'clientEditedAt'])
      && !('status' in old)
      && !('invoiceNumber' in old)
      && !('updatedAt' in old)
      && !('locked' in old)
      && request.time < old.createdAt + duration.value(7, 'd')
      && data.id == orderId
      && data.id == old.id
      && data.date == old.date
      && data.createdAt == old.createdAt
      && data.customer == old.customer
      && data.fee == old.fee
      && data.clientEditedAt == request.time
      && items is list
      && oldItems is list
      && items.size() >= oldItems.size()
      && items.size() <= oldItems.size() + 8
      && items.size() <= 20
      && clientLineOk(items, oldItems, 0) && clientLineOk(items, oldItems, 1) && clientLineOk(items, oldItems, 2) && clientLineOk(items, oldItems, 3) && clientLineOk(items, oldItems, 4) && clientLineOk(items, oldItems, 5) && clientLineOk(items, oldItems, 6) && clientLineOk(items, oldItems, 7) && clientLineOk(items, oldItems, 8) && clientLineOk(items, oldItems, 9) && clientLineOk(items, oldItems, 10) && clientLineOk(items, oldItems, 11) && clientLineOk(items, oldItems, 12) && clientLineOk(items, oldItems, 13) && clientLineOk(items, oldItems, 14) && clientLineOk(items, oldItems, 15) && clientLineOk(items, oldItems, 16) && clientLineOk(items, oldItems, 17) && clientLineOk(items, oldItems, 18) && clientLineOk(items, oldItems, 19)
      && data.subtotal == lineAmount(items, 0) + lineAmount(items, 1) + lineAmount(items, 2) + lineAmount(items, 3) + lineAmount(items, 4) + lineAmount(items, 5) + lineAmount(items, 6) + lineAmount(items, 7) + lineAmount(items, 8) + lineAmount(items, 9) + lineAmount(items, 10) + lineAmount(items, 11) + lineAmount(items, 12) + lineAmount(items, 13) + lineAmount(items, 14) + lineAmount(items, 15) + lineAmount(items, 16) + lineAmount(items, 17) + lineAmount(items, 18) + lineAmount(items, 19)
      && data.subtotal > 0
      && data.total == data.subtotal + data.fee;
  }

  // Modification par l'admin : mêmes contrôles qu'à la création, avec les champs de suivi en plus.
  // L'identifiant, la date de création et un numéro de facture déjà attribué ne changent jamais.
  function validOrderUpdate(orderId) {
    let data = request.resource.data;
    let customer = data.customer;
    return data.keys().hasOnly(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total', 'updatedAt', 'status', 'invoiceNumber', 'invoicedAt', 'clientEditedAt', 'locked', 'source', 'note'])
      && data.keys().hasAll(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total'])
      && data.id == orderId
      && data.id == resource.data.id
      && data.date == resource.data.date
      && data.createdAt == resource.data.createdAt
      && customer is map
      && customer.keys().hasOnly(['name', 'phone', 'address', 'zone'])
      && customer.keys().hasAll(['name', 'phone', 'address', 'zone'])
      && customer.name is string
      && customer.name.size() > 0
      && customer.name.size() <= 100
      && customer.phone is string
      && customer.phone.size() >= 8
      && customer.phone.size() <= 25
      && customer.address is string
      && customer.address.size() <= 300
      && customer.zone is string
      && customer.zone.size() <= 200
      && data.items is list
      && data.items.size() > 0
      && data.items.size() <= 50
      && data.subtotal is number
      && data.subtotal >= 0
      && data.fee is number
      && data.fee >= 0
      && data.total is number
      && data.total == data.subtotal + data.fee
      && (!('status' in data) || data.status == 'cancelled')
      && (!('updatedAt' in data) || data.updatedAt is timestamp)
      && (!('invoicedAt' in data) || data.invoicedAt is timestamp)
      && (!('clientEditedAt' in data) || data.clientEditedAt is timestamp)
      && (!('locked' in data) || data.locked == true)
      && (!('source' in data) || data.source in ['telephone', 'whatsapp', 'place'])
      && (!('note' in data) || (data.note is string && data.note.size() <= 300))
      && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.matches('^FAC-[0-9]{4}-[0-9]{4,}$')))
      && (!('invoiceNumber' in resource.data) || data.invoiceNumber == resource.data.invoiceNumber);
  }

  function validOrder(orderId) {
    let data = request.resource.data;
    let customer = data.customer;
    return data.keys().hasOnly(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total'])
      && data.keys().hasAll(['id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'fee', 'total'])
      && data.id == orderId
      && data.date is string
      && data.date.size() <= 40
      && data.createdAt is timestamp
      && customer is map
      && customer.keys().hasOnly(['name', 'phone', 'address', 'zone'])
      && customer.keys().hasAll(['name', 'phone', 'address', 'zone'])
      && customer.name is string
      && customer.name.size() > 0
      && customer.name.size() <= 100
      && customer.phone is string
      && customer.phone.size() >= 8
      && customer.phone.size() <= 25
      && customer.address is string
      && customer.address.size() > 0
      && customer.address.size() <= 300
      && customer.zone is string
      && customer.zone.size() <= 200
      && data.items is list
      && data.items.size() > 0
      && data.items.size() <= 50
      && data.subtotal is number
      && data.subtotal >= 0
      && data.fee is number
      && data.fee >= 0
      && data.total is number
      && data.total == data.subtotal + data.fee;
  }

  match /databases/{database}/documents {
    match /catalogProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == 'delivery' || settingId == 'whatsapp' || settingId == 'announcement';
      allow create, update: if isAdmin()
        && ((settingId == 'delivery' && validDeliverySettings())
          || (settingId == 'whatsapp' && validWhatsAppSettings())
          || (settingId == 'announcement' && validAnnouncement()));
      allow delete: if false;
    }

    match /farmAlbum/{photoId} {
      allow read: if true;
      allow create, update: if isAdmin() && validAlbumPhoto(photoId);
      allow delete: if isAdmin();
    }

    // Statut « livré » des commandes : aucune donnée client, réservé à l'admin.
    match /deliveries/{orderId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validDelivery(orderId);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if (request.auth != null && validOrder(orderId)) || (isAdmin() && validAdminOrder(orderId));
      allow read: if isAdmin();
      allow update: if (isAdmin() && validOrderUpdate(orderId)) || validClientEdit(orderId);
      allow delete: if isAdmin();
    }

    // Compteur des numéros de facture : un par année, qui n'avance que de 1 à la fois.
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && counterId.matches('^invoices-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['year', 'last'])
        && request.resource.data.year is int
        && request.resource.data.last == 1;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['year', 'last'])
        && request.resource.data.last == resource.data.last + 1;
      allow delete: if false;
    }
  }
}